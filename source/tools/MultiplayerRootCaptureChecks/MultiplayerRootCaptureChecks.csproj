<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../local.props" Condition="Exists('../../local.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Runtime/MultiplayerRemotePublicRelicSupport.cs" Link="MultiplayerRemotePublicRelicSupport.cs" />
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" />
  </ItemGroup>
  <Target Name="ValidateReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="请通过 local.props 或 -p:Sts2DataDir=... 指定当前游戏数据目录。" />
  </Target>
</Project>
